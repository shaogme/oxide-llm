# Set the default active model configuration name
active_model = "my-openai-responses"

# --- Provider Definitions ---

[[providers]]
id = "openai_provider"
base_url = "https://api.openai.com/v1"
api_key = "sk-..."

[[providers]]
id = "claude_provider"
base_url = "https://api.anthropic.com/v1"
api_key = "sk-ant-..."

[[providers]]
id = "gemini_provider"
base_url = "https://generativelanguage.googleapis.com/v1beta"
api_key = "AIza..."

# --- Model Definitions ---
# Unified agent configuration supports required fields (`type`, `model`), optional fields (`endpoint`, `max_tokens`),
# and optional tuning parameters (`temperature`, `top_p`, `top_k`, `frequency_penalty`, `presence_penalty`, `stop_sequences`, `seed`, `reasoning_effort`).
# Note: `endpoint` defaults automatically if omitted ("chat/completions", "responses", "messages", "interactions", or "models/{model}").

# Example for OpenAI Responses API
[[models]]
name = "my-openai-responses"
provider = "openai_provider"
type = "openai-responses"
model = "gpt-4.5-preview"
endpoint = "responses"
temperature = 0.7
reasoning_effort = "medium"

# Example for OpenAI Chat Completions
[[models]]
name = "my-openai-chat"
provider = "openai_provider"
type = "openai-chat-completions"
model = "gpt-3.5-turbo"
endpoint = "chat/completions"
temperature = 0.7
top_p = 0.95
frequency_penalty = 0.5
presence_penalty = 0.5
stop_sequences = ["\nUser:"]
seed = 42

# Example for Claude
[[models]]
name = "my-claude"
provider = "claude_provider"
type = "claude-messages"
model = "claude-3-opus-20240229"
endpoint = "messages"
max_tokens = 1024
temperature = 0.5
reasoning_effort = "high"

# Example for Gemini Interactions API
[[models]]
name = "my-gemini-interactions"
provider = "gemini_provider"
type = "gemini-interactions"
model = "gemini-3.6-flash"
endpoint = "interactions"
reasoning_effort = "low"

# Example for Gemini Generate Content API
[[models]]
name = "my-gemini-generate"
provider = "gemini_provider"
type = "gemini-generate-content"
model = "gemini-3-flash"
endpoint = "models/gemini-3-flash:streamGenerateContent"
temperature = 0.8
top_k = 40